<?xml version="1.0"?>
<robot name="maze_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find task1_robot_description)/urdf/parts/params.xacro"/>
  <xacro:include filename="$(find task1_robot_description)/urdf/parts/inertial.xacro"/>
  <xacro:include filename="$(find task1_robot_description)/urdf/parts/chassis.xacro"/>
  <xacro:include filename="$(find task1_robot_description)/urdf/parts/wheel.xacro"/>
  <xacro:include filename="$(find task1_robot_description)/urdf/parts/lidar.xacro"/>
  <xacro:include filename="$(find task1_robot_description)/urdf/parts/gazebo.xacro"/>

  <xacro:chassis/>
  <xacro:wheel side="left" mirror="1"/>
  <xacro:wheel side="right" mirror="-1"/>
  <xacro:lidar/>
  <xacro:gazebo_ros/>
</robot>
