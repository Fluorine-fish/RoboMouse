  <xacro:property name="wheel_separation" value="0.28"/>
  <xacro:property name="wheel_mass" value="0.20"/>

  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_mass" value="0.08"/>
  <xacro:property name="lidar_radius" value="0.045"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.05"/>
</robot>
