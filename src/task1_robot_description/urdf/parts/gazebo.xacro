<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 差速驱动与关节状态由 Gazebo 发布。 -->
  <xacro:macro name="gazebo_ros">
    <gazebo reference="base_link">
      <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="left_wheel_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
    <gazebo reference="caster_link">
      <mu1>0.02</mu1>
      <mu2>0.02</mu2>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>/model/task1_robot/cmd_vel</topic>
        <odom_topic>/wheel_odom</odom_topic>
        <odom_publish_frequency>20</odom_publish_frequency>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <max_linear_velocity>0.6</max_linear_velocity>
        <min_linear_velocity>-0.6</min_linear_velocity>
        <max_linear_acceleration>0.5</max_linear_acceleration>
        <min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>
        <max_angular_acceleration>1.5</max_angular_acceleration>
        <min_angular_acceleration>-1.5</min_angular_acceleration>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/world/maze_world/model/task1_robot/joint_state</topic>
      </plugin>

      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/odom</odom_topic>
        <odom_publish_frequency>20</odom_publish_frequency>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
